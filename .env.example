# Copy to .env and fill in. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Postgres — where conversations and feedback are logged. Defaults match
# docker-compose.yaml, so you only need to change these if you already use port 5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pci
POSTGRES_USER=pci
POSTGRES_PASSWORD=pci

# Grafana login
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
